# StoreSight Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_URL=jdbc:postgresql://localhost:5432/storesight
DB_USER=storesight
DB_PASS=storesight
DB_POOL_SIZE=15
DB_MIN_IDLE=4
DB_CONNECTION_TIMEOUT=45000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_POOL_MAX_ACTIVE=10
REDIS_POOL_MAX_IDLE=8
REDIS_TIMEOUT=5000

# Optimized Sessions
SESSION_TIMEOUT_HOURS=4
SESSION_CLEANUP_MINUTES=15
MAX_SESSIONS_PER_SHOP=5

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=8080
BACKEND_URL=http://localhost:8080

# =============================================================================
# SHOPIFY CONFIGURATION
# =============================================================================
# Get these from your Shopify Partner account
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2023-10
SHOPIFY_ADMIN_BASE_URL=https://{shop}.myshopify.com/admin
SHOPIFY_REDIRECT_URI=http://localhost:8080/api/auth/shopify/callback
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:5173

# =============================================================================
# MARKET INTELLIGENCE APIs (NEW!)
# =============================================================================
# Primary Provider - Scrapingdog (Most Cost-Effective: $0.001/search)
# Sign up at: https://scrapingdog.com (1000 free credits/month)
SCRAPINGDOG_KEY=
SCRAPINGDOG_BASE_URL=https://api.scrapingdog.com/google
SCRAPINGDOG_MAX_RESULTS=10

# Secondary Provider - Serper (Fast Fallback: $0.001/search) 
# Sign up at: https://serper.dev (2500 free searches)
SERPER_KEY=
SERPER_BASE_URL=https://google.serper.dev/search
SERPER_MAX_RESULTS=10

# Enterprise Provider - SerpAPI (Premium: $0.015/search)
# Sign up at: https://serpapi.com (100 free searches/month)
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_MAX_RESULTS=3

# =============================================================================
# MARKET INTELLIGENCE CONFIGURATION
# =============================================================================
# Multi-source settings
DISCOVERY_MULTI_SOURCE_ENABLED=true
DISCOVERY_FALLBACK_ENABLED=true
DISCOVERY_MAX_PROVIDERS=3

# Discovery behavior
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_HOURS=24
DISCOVERY_MAX_RESULTS=10

# Provider-specific limits
SCRAPINGDOG_MAX_RESULTS=10
SERPER_MAX_RESULTS=10
SERPAPI_MAX_RESULTS=3

# =============================================================================
# SENDGRID CONFIGURATION
# =============================================================================
# Get this from your SendGrid account
SENDGRID_API_KEY=

# =============================================================================
# TWILIO CONFIGURATION
# =============================================================================
# Get these from your Twilio account
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Server configuration
SERVER_PORT=8080

# Frontend URL (for redirects after authentication)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Logging levels: DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_STORESIGHT=DEBUG
LOGGING_LEVEL_SPRING=INFO
LOGGING_LEVEL_HIBERNATE=DEBUG
LOGGING_LEVEL=INFO

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to true for development, false for production
SPRING_PROFILES_ACTIVE=dev
DEBUG_ENABLED=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT secret for session management (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session timeout (in minutes)
SESSION_TIMEOUT=60

# =============================================================================
# ADMIN AUTHENTICATION CONFIGURATION
# =============================================================================
# Admin credentials for the admin portal, use BCrypt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2a$12$encrypted-password

# JWT secret for admin authentication (must be at least 64 characters for HS512)
# This can be the same as JWT_SECRET or a separate key
ADMIN_JWT_SECRET=your-super-secret-jwt-key-that-should-be-at-least-64-characters-long-for-production-use-and-should-be-kept-secure

# Admin authentication settings
ADMIN_AUTH_ENABLED=true
ADMIN_SESSION_TIMEOUT=3600
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION=900
ADMIN_TOKEN_EXPIRY=86400
ADMIN_REQUIRE_HTTPS=true
ADMIN_AUDIT_LOGGING=true

# =============================================================================
# RATE LIMITING
# =============================================================================
# API rate limiting configuration
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
API_RATE_LIMIT_BURST_SIZE=10

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Email notification settings
EMAIL_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=true

# Notification cleanup settings
NOTIFICATIONS_CLEANUP_ENABLED=true
NOTIFICATIONS_CLEANUP_RETENTION_DAYS=30
NOTIFICATIONS_CLEANUP_BATCH_SIZE=100
NOTIFICATIONS_CLEANUP_MAX_READ=50
NOTIFICATIONS_CLEANUP_MAX_UNREAD=100

# =============================================================================
# COMPETITOR DISCOVERY (LEGACY - DEPRECATED)
# =============================================================================
# Competitor discovery service settings
# Note: Use MARKET INTELLIGENCE CONFIGURATION above instead
DISCOVERY_PROVIDER=multi-source

# =============================================================================
# CACHE CONFIGURATION (NEW!)
# =============================================================================
# Exponential caching for cost optimization
CACHE_SEARCH_RESULTS_MINUTES=120
CACHE_SUGGESTION_COUNT_MINUTES=30
CACHE_MAX_SIZE=1000
CACHE_TTL_MINUTES=120

# =============================================================================
# DATA PRIVACY
# =============================================================================
# Data retention settings (in days)
DATA_RETENTION_DAYS=90
AUTO_DELETE_ENABLED=false

# =============================================================================
# MONITORING
# =============================================================================
# Health check and monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Auto-deploy trigger for Render
AUTO_DEPLOY_TRIGGER=on

# =============================================================================
# STORESIGHT CONFIGURATION PROPERTIES
# =============================================================================

# SSE (Server-Sent Events) Configuration
SSE_MAX_CONNECTIONS_PER_SHOP=5
SSE_MAX_CONNECTIONS_GLOBAL=50
SSE_CONNECTION_TIMEOUT=PT2M
SSE_HEARTBEAT_INTERVAL=PT30S
SSE_CLEANUP_INTERVAL=PT1M
SSE_MAX_BATCH_SIZE=10
SSE_BATCH_TIMEOUT=PT1S
SSE_MAX_BATCH_QUEUE_SIZE=100
SSE_CONNECTION_HEALTH_CHECK_INTERVAL=PT45S
SSE_DEAD_CONNECTION_TIMEOUT=PT90S
SSE_BATCH_CLEANUP_INTERVAL=PT30S
SSE_MAX_FAILED_HEARTBEATS=3
SSE_BATCH_MEMORY_CLEANUP_THRESHOLD=PT5M
SSE_MAX_BATCH_MEMORY_SIZE_BYTES=1048576
SSE_CONNECTION_IDLE_TIMEOUT=PT10M
SSE_EMERGENCY_CLEANUP_THRESHOLD=80

# Session Management Configuration
SESSION_LOCK_DURATION=PT5S
SESSION_INVALIDATION_TRACKING_DURATION=PT1H
SESSION_STUCK_SESSION_TIMEOUT=PT5M
SESSION_ORPHANED_LOCK_TIMEOUT=PT10M
SESSION_DATA_TTL=PT4H
SESSION_TOKEN_TTL=PT2H
SESSION_SHOP_SESSIONS_TTL=PT1H
SESSION_INVALID_SESSION_TTL=PT15M
SESSION_MAX_SESSIONS_PER_SHOP=5
SESSION_INACTIVITY_HOURS=4
SESSION_CLEANUP_DAYS=2
SESSION_REDIS_CACHE_TTL_MINUTES=120
SESSION_REDIS_FALLBACK_TTL_MINUTES=60
SESSION_INVALID_SESSION_CACHE_MINUTES=15

# Cache Configuration
CACHE_DEFAULT_TTL=PT15M
CACHE_MEMORY_TTL=PT5M
CACHE_MAX_MEMORY_CACHE_SIZE=1000
CACHE_CLEANUP_INTERVAL=PT5M
CACHE_STATISTICS_INTERVAL=PT10M
CACHE_MAX_BATCH_SIZE=50
CACHE_BATCH_TIMEOUT=PT30S

# Monitoring Configuration
MONITORING_SYSTEM_RESOURCES_INTERVAL=PT1M
MONITORING_DATABASE_INTERVAL=PT2M
MONITORING_REDIS_INTERVAL=PT3M
MONITORING_SESSION_CLEANUP_INTERVAL=PT5M
MONITORING_SSE_CLEANUP_INTERVAL=PT1M
MONITORING_CACHE_CLEANUP_INTERVAL=PT5M
MONITORING_DASHBOARD_COLLECTION_INTERVAL=PT30S
MONITORING_HEALTH_CHECK_INTERVAL=PT30S
MONITORING_CONNECTION_TEST_TIMEOUT=PT5S
MONITORING_MEMORY_WARNING_THRESHOLD=80
MONITORING_MEMORY_CRITICAL_THRESHOLD=95
MONITORING_CPU_WARNING_THRESHOLD=80
MONITORING_CPU_CRITICAL_THRESHOLD=95
MONITORING_DISK_WARNING_THRESHOLD=80
MONITORING_DISK_CRITICAL_THRESHOLD=95
MONITORING_CONNECTION_POOL_WARNING_THRESHOLD=80
MONITORING_CONNECTION_POOL_CRITICAL_THRESHOLD=95
MONITORING_STUCK_SESSION_THRESHOLD=5
MONITORING_SSE_ERROR_RATE_THRESHOLD=10
MONITORING_DATABASE_ERROR_RATE_THRESHOLD=5
MONITORING_CACHE_HIT_RATE_THRESHOLD=50

# Security Configuration
SECURITY_RATE_LIMIT_WINDOW=PT1M
SECURITY_RATE_LIMIT_REQUESTS=60
SECURITY_ADMIN_SESSION_TIMEOUT=PT1H
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_DURATION=PT15M
SECURITY_TOKEN_EXPIRY=PT24H
SECURITY_REQUIRE_HTTPS=true
SECURITY_AUDIT_LOGGING=true
SECURITY_CSRF_ENABLED=true
SECURITY_XSS_PROTECTION=true
SECURITY_CONTENT_SECURITY_POLICY=true
SECURITY_SESSION_VALIDATION_INTERVAL=PT5M
SECURITY_IP_VALIDATION_TIMEOUT=PT30M

# Discovery Configuration
DISCOVERY_CACHE_TIMEOUT=PT2H
DISCOVERY_MAX_RESULTS=10
DISCOVERY_MAX_CONCURRENT_REQUESTS=3
DISCOVERY_REQUEST_TIMEOUT=PT30S
DISCOVERY_RATE_LIMIT_DELAY=PT0.5S
DISCOVERY_MAX_SUGGESTIONS_PER_PRODUCT=5
DISCOVERY_MAX_PRODUCTS_PER_SHOP=50
DISCOVERY_MAX_TOTAL_SUGGESTIONS=200
DISCOVERY_MAX_URLS_PER_SHOP=100
DISCOVERY_MAX_PRODUCTS=20
DISCOVERY_KEYWORD_CACHE_TTL=PT30M
DISCOVERY_MIN_KEYWORD_FREQUENCY=2

# =============================================================================
# FEATURE FLAGS CONFIGURATION
# =============================================================================

# Session Management Features
FEATURE_SESSION_ENHANCED_SYNCHRONIZATION=true
FEATURE_SESSION_STUCK_SESSION_CLEANUP=true
FEATURE_SESSION_DISTRIBUTED_LOCKING=true
FEATURE_SESSION_VALIDATION=true
FEATURE_SESSION_ASYNC_UPDATES=true
FEATURE_SESSION_METRICS=true
FEATURE_SESSION_EMERGENCY_CLEANUP=true

# SSE Features
FEATURE_SSE_EVENT_BATCHING=true
FEATURE_SSE_CONNECTION_HEALTH_CHECKS=true
FEATURE_SSE_DEAD_CONNECTION_CLEANUP=true
FEATURE_SSE_EMERGENCY_CLEANUP=true
FEATURE_SSE_MEMORY_MANAGEMENT=true
FEATURE_SSE_CONNECTION_LIMITS=true
FEATURE_SSE_HEARTBEAT_MONITORING=true
FEATURE_SSE_PERFORMANCE_METRICS=true

# Cache Features
FEATURE_CACHE_MULTI_LEVEL_CACHING=true
FEATURE_CACHE_SESSION_AWARE_CACHING=true
FEATURE_CACHE_STATISTICS=true
FEATURE_CACHE_AUTOMATIC_CLEANUP=true
FEATURE_CACHE_MEMORY_OPTIMIZATION=true
FEATURE_CACHE_DISTRIBUTED_CACHING=true
FEATURE_CACHE_WARMING=true

# Monitoring Features
FEATURE_MONITORING_ENHANCED_METRICS=true
FEATURE_MONITORING_PERFORMANCE_MONITORING=true
FEATURE_MONITORING_HEALTH_CHECKS=true
FEATURE_MONITORING_ALERTING=true
FEATURE_MONITORING_RESOURCE_MONITORING=true
FEATURE_MONITORING_CONNECTION_POOL_MONITORING=true
FEATURE_MONITORING_DATABASE_MONITORING=true
FEATURE_MONITORING_CUSTOM_METRICS=true

# Security Features
FEATURE_SECURITY_ENHANCED_AUTHENTICATION=true
FEATURE_SECURITY_RATE_LIMITING=true
FEATURE_SECURITY_AUDIT_LOGGING=true
FEATURE_SECURITY_SESSION_SECURITY=true
FEATURE_SECURITY_IP_VALIDATION=true
FEATURE_SECURITY_CSRF_PROTECTION=true
FEATURE_SECURITY_XSS_PROTECTION=true
FEATURE_SECURITY_HEADERS=true

# Discovery Features
FEATURE_DISCOVERY_MULTI_SOURCE_DISCOVERY=true
FEATURE_DISCOVERY_CACHE_OPTIMIZATION=true
FEATURE_DISCOVERY_RATE_LIMITING=true
FEATURE_DISCOVERY_KEYWORD_GENERATION=true
FEATURE_DISCOVERY_PRODUCT_AWARE_DISCOVERY=true
FEATURE_DISCOVERY_FALLBACK_MECHANISMS=true
FEATURE_DISCOVERY_PERFORMANCE_OPTIMIZATION=true

# =============================================================================
# GRADUAL ROLLOUT CONFIGURATION
# =============================================================================

# Gradual Rollout Settings
FEATURE_ROLLOUT_ENABLED=false
FEATURE_ROLLOUT_SESSION_MANAGEMENT_PERCENTAGE=100
FEATURE_ROLLOUT_SSE_IMPROVEMENTS_PERCENTAGE=100
FEATURE_ROLLOUT_CACHE_OPTIMIZATION_PERCENTAGE=100
FEATURE_ROLLOUT_MONITORING_ENHANCEMENTS_PERCENTAGE=100
FEATURE_ROLLOUT_SECURITY_HARDENING_PERCENTAGE=100
FEATURE_ROLLOUT_DISCOVERY_OPTIMIZATION_PERCENTAGE=100
FEATURE_ROLLOUT_STRATEGY=PERCENTAGE_BASED

# =============================================================================
# COST OPTIMIZATION NOTES
# =============================================================================
# 
# Market Intelligence Cost Comparison:
# - Scrapingdog: $0.001/search (97% cheaper than SerpAPI)
# - Serper: $0.001/search (97% cheaper than SerpAPI)  
# - SerpAPI: $0.015/search (premium accuracy)
#
# Recommended setup for maximum savings:
# 1. Set SCRAPINGDOG_KEY for primary searches
# 2. Set SERPER_KEY for fallback  
# 3. Leave SERPAPI_KEY empty unless you need premium accuracy
#
# With exponential caching enabled, expect 95% reduction in API calls
# Annual savings: ~$14,000 for 1M searches vs SerpAPI-only
#
# Configuration Management:
# - All settings can be controlled via environment variables
# - Feature flags allow safe rollout of new functionality
# - Gradual rollout enables percentage-based feature deployment
# - Emergency rollback available via configuration changes
#
