# StoreSight Production Environment Configuration
# This file contains production-ready settings for Render deployment

# =============================================================================
# DATABASE CONFIGURATION (Render PostgreSQL)
# =============================================================================
# These will be automatically populated by Render from the database service
DB_URL=${DB_URL}
DB_USER=${DB_USER}
DB_PASS=${DB_PASS}
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_LEAK_DETECTION=60000
DB_VALIDATION_TIMEOUT=5000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# =============================================================================
# REDIS CONFIGURATION (Render Redis)
# =============================================================================
# These will be automatically populated by Render from the Redis service
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=4
REDIS_TIMEOUT=10000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
BACKEND_URL=https://api.shopgaugeai.com
FRONTEND_URL=https://www.shopgaugeai.com

# =============================================================================
# SHOPIFY CONFIGURATION
# =============================================================================
SHOPIFY_API_KEY=${SHOPIFY_API_KEY}
SHOPIFY_API_SECRET=${SHOPIFY_API_SECRET}
SHOPIFY_REDIRECT_URI=${SHOPIFY_REDIRECT_URI}
SHOPIFY_SCOPES=${SHOPIFY_SCOPES}
SHOPIFY_API_VERSION=2023-10
SHOPIFY_ADMIN_BASE_URL=https://{shop}.myshopify.com/admin

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=${JWT_SECRET}
ADMIN_USERNAME=${ADMIN_USERNAME}
ADMIN_PASSWORD=${ADMIN_PASSWORD}
ADMIN_JWT_SECRET=${ADMIN_JWT_SECRET}

# =============================================================================
# API KEYS
# =============================================================================
SCRAPINGDOG_KEY=${SCRAPINGDOG_KEY}
SERPER_KEY=${SERPER_KEY}
SERPAPI_KEY=${SERPAPI_KEY}
SENDGRID_API_KEY=${SENDGRID_API_KEY:-}
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID:-}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN:-}
TWILIO_FROM_NUMBER=${TWILIO_FROM_NUMBER:-+1234567890}

# =============================================================================
# FEATURE FLAGS
# =============================================================================
DISCOVERY_ENABLED=${DISCOVERY_ENABLED}
DISCOVERY_MULTI_SOURCE_ENABLED=${DISCOVERY_MULTI_SOURCE_ENABLED}
DISCOVERY_FALLBACK_ENABLED=${DISCOVERY_FALLBACK_ENABLED}
DISCOVERY_MAX_PROVIDERS=3
DISCOVERY_INTERVAL_HOURS=24
DISCOVERY_MAX_RESULTS=10

HEALTH_CHECK_ENABLED=${HEALTH_CHECK_ENABLED}
METRICS_ENABLED=${METRICS_ENABLED}
EMAIL_NOTIFICATIONS_ENABLED=${EMAIL_NOTIFICATIONS_ENABLED}
SMS_NOTIFICATIONS_ENABLED=${SMS_NOTIFICATIONS_ENABLED}

# =============================================================================
# LOGGING CONFIGURATION (Production Optimized)
# =============================================================================
LOGGING_LEVEL_ROOT=${LOGGING_LEVEL_ROOT}
LOGGING_LEVEL_STORESIGHT=${LOGGING_LEVEL_STORESIGHT}
LOGGING_LEVEL_SPRING=${LOGGING_LEVEL_SPRING}
LOGGING_LEVEL_HIBERNATE=${LOGGING_LEVEL_HIBERNATE}

# =============================================================================
# PERFORMANCE CONFIGURATION (Production Optimized)
# =============================================================================
# Session Management - Production Settings
SESSION_TIMEOUT_HOURS=2
SESSION_CLEANUP_MINUTES=30
MAX_SESSIONS_PER_SHOP=3
SESSION_LOCK_DURATION=PT10S
SESSION_DATA_TTL=PT2H
SESSION_TOKEN_TTL=PT1H
SESSION_MAX_SESSIONS_PER_SHOP=3

# SSE Configuration - Production Settings
SSE_MAX_CONNECTIONS_PER_SHOP=3
SSE_MAX_CONNECTIONS_GLOBAL=30
SSE_CONNECTION_TIMEOUT=PT90S
SSE_HEARTBEAT_INTERVAL=PT45S
SSE_CLEANUP_INTERVAL=PT2M
SSE_MAX_BATCH_SIZE=5
SSE_BATCH_TIMEOUT=PT2S

# Cache Configuration - Production Settings
CACHE_DEFAULT_TTL=PT30M
CACHE_MEMORY_TTL=PT10M
CACHE_MAX_MEMORY_CACHE_SIZE=500
CACHE_CLEANUP_INTERVAL=PT10M

# Monitoring Configuration - Production Settings
MONITORING_SYSTEM_RESOURCES_INTERVAL=PT5M
MONITORING_DATABASE_INTERVAL=PT5M
MONITORING_REDIS_INTERVAL=PT10M
MONITORING_HEALTH_CHECK_INTERVAL=PT1M
MONITORING_MEMORY_WARNING_THRESHOLD=80
MONITORING_MEMORY_CRITICAL_THRESHOLD=90
MONITORING_CPU_WARNING_THRESHOLD=80
MONITORING_CPU_CRITICAL_THRESHOLD=90

# Security Configuration - Production Settings
SECURITY_RATE_LIMIT_WINDOW=PT1M
SECURITY_RATE_LIMIT_REQUESTS=30
SECURITY_ADMIN_SESSION_TIMEOUT=PT30M
SECURITY_MAX_LOGIN_ATTEMPTS=3
SECURITY_LOCKOUT_DURATION=PT30M
SECURITY_REQUIRE_HTTPS=true
SECURITY_AUDIT_LOGGING=true
SECURITY_CSRF_ENABLED=true
SECURITY_XSS_PROTECTION=true

# Discovery Configuration - Production Settings
DISCOVERY_CACHE_TIMEOUT=PT4H
DISCOVERY_MAX_CONCURRENT_REQUESTS=2
DISCOVERY_REQUEST_TIMEOUT=PT30S
DISCOVERY_RATE_LIMIT_DELAY=PT2S
DISCOVERY_MAX_SUGGESTIONS_PER_PRODUCT=3
DISCOVERY_MAX_PRODUCTS_PER_SHOP=20

# =============================================================================
# FEATURE FLAGS (Production Safe)
# =============================================================================
# Session Management Features
FEATURE_SESSION_ENHANCED_SYNCHRONIZATION=true
FEATURE_SESSION_STUCK_SESSION_CLEANUP=true
FEATURE_SESSION_DISTRIBUTED_LOCKING=true
FEATURE_SESSION_VALIDATION=true
FEATURE_SESSION_METRICS=true

# SSE Features
FEATURE_SSE_EVENT_BATCHING=true
FEATURE_SSE_CONNECTION_HEALTH_CHECKS=true
FEATURE_SSE_DEAD_CONNECTION_CLEANUP=true
FEATURE_SSE_MEMORY_MANAGEMENT=true
FEATURE_SSE_CONNECTION_LIMITS=true

# Cache Features
FEATURE_CACHE_MULTI_LEVEL_CACHING=true
FEATURE_CACHE_STATISTICS=true
FEATURE_CACHE_AUTOMATIC_CLEANUP=true
FEATURE_CACHE_MEMORY_OPTIMIZATION=true

# Monitoring Features
FEATURE_MONITORING_ENHANCED_METRICS=true
FEATURE_MONITORING_PERFORMANCE_MONITORING=true
FEATURE_MONITORING_HEALTH_CHECKS=true
FEATURE_MONITORING_RESOURCE_MONITORING=true

# Security Features
FEATURE_SECURITY_ENHANCED_AUTHENTICATION=true
FEATURE_SECURITY_RATE_LIMITING=true
FEATURE_SECURITY_AUDIT_LOGGING=true
FEATURE_SECURITY_SESSION_SECURITY=true
FEATURE_SECURITY_CSRF_PROTECTION=true
FEATURE_SECURITY_XSS_PROTECTION=true

# Discovery Features
FEATURE_DISCOVERY_MULTI_SOURCE_DISCOVERY=true
FEATURE_DISCOVERY_CACHE_OPTIMIZATION=true
FEATURE_DISCOVERY_RATE_LIMITING=true
FEATURE_DISCOVERY_FALLBACK_MECHANISMS=true