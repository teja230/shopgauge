# Shopify OAuth callback - let frontend handle API calls directly
# No API proxying needed - frontend will call backend directly

# Static assets - serve directly
/assets/*                   /assets/* 200
/vite.svg                   /vite.svg                        200
/favicon.ico                /favicon.ico                     200
/manifest.json              /manifest.json                   200

# Valid application routes - serve main app and let React Router handle them
# Use 200! to force override and prevent 404.html from being served
# Order matters - more specific routes first
/admin/*                    /index.html                      200!
/admin                      /index.html                      200!
/dashboard/*                /index.html                      200!
/dashboard                  /index.html                      200!
/competitors/*              /index.html                      200!
/competitors                /index.html                      200!
/profile/*                  /index.html                      200!
/profile                    /index.html                      200!
/privacy-policy             /index.html                      200!
/service-unavailable        /index.html                      200!

# Root routes - serve main app
/                           /index.html                      200!
/index.html                 /index.html                      200!

# Catch-all for unknown routes - let React Router handle 404s
/*                          /index.html                      200! 